# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Search Console API — private credentials and generated reports
scripts/search-console/credentials.json
scripts/search-console/output/

# GA4 Data API — generated reports
scripts/analytics/output/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.md
!BTC500_GROWTH.md
!scripts/autonomous/*.md
!scripts/autonomous/outreach/*.md
!.opencode/agents/*.md
# Improvement plans (shadcn/improve skill) live in plans/ and must be committable.
!plans/*.md
# Root-level scratch directory only. Without the leading slash this pattern
# also matched scripts/search-console/, which silently excluded the Search
# Console tooling from every commit.
/search-console/

# Agent skills installed with `npx skills add` (design-taste-frontend, improve,
# ...). They are local tooling for the agent, thousands of vendored files that
# must never enter the repository or a deploy. skills-lock.json stays tracked
# as the manifest of what is installed.
/.agents/

# Scratch state written by the taste-skill scripts: the deal history, the
# chrome profile used by the checker and the screenshots it takes.
/.taste-skill/
/taste-skill-consistency/